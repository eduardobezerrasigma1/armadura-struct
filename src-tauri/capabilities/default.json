{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-files",
  "description": "Arquivos explicitamente selecionados nos diálogos da janela principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file"
  ]
}
